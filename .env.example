# Omnix Environment Configuration

# ------------------------------------------------------------------------------
# CORE SYSTEM
# ------------------------------------------------------------------------------
OMNIX_ENV=development
OMNIX_LOG_LEVEL=debug
OMNIX_DATA_DIR=~/.omnix/data

# ------------------------------------------------------------------------------
# AI PROVIDERS (Pluggable Architecture)
# ------------------------------------------------------------------------------
# Default reasoning engine
PRIMARY_LLM_PROVIDER=placeholder_provider
PRIMARY_LLM_MODEL=placeholder_model_name
PRIMARY_LLM_API_KEY=

# Fallback/Fast reasoning engine
FAST_LLM_PROVIDER=placeholder_provider
FAST_LLM_MODEL=placeholder_model_name
FAST_LLM_API_KEY=

# ------------------------------------------------------------------------------
# PERCEPTION & VISION
# ------------------------------------------------------------------------------
VISION_PROVIDER=placeholder_provider
VISION_MODEL=placeholder_model_name
VISION_API_KEY=

# Optional: Dedicated OCR engine override
OCR_PROVIDER=placeholder_provider

# ------------------------------------------------------------------------------
# SPEECH & VOICE
# ------------------------------------------------------------------------------
# Speech-To-Text (STT) Provider
STT_PROVIDER=placeholder_provider
STT_API_KEY=

# Text-To-Speech (TTS) Provider
TTS_PROVIDER=placeholder_provider
TTS_VOICE_ID=
TTS_API_KEY=

# Voice Activity Detection (VAD) / Wake Word
VAD_PROVIDER=placeholder_provider
WAKE_WORD_ENGINE=placeholder_provider

# ------------------------------------------------------------------------------
# MEMORY & STORAGE
# ------------------------------------------------------------------------------
# Vector DB Provider (e.g., for semantic memory)
VECTOR_DB_PROVIDER=placeholder_provider
VECTOR_DB_HOST=
VECTOR_DB_KEY=

# ------------------------------------------------------------------------------
# SAFETY & EXECUTION
# ------------------------------------------------------------------------------
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
MAX_RECOVERY_ATTEMPTS=3
ENABLE_SHELL_EXECUTION=false # ALWAYS FALSE BY DEFAULT

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Add integration specific keys here as modules are implemented
# e.g., GITHUB_TOKEN=
