# Omnix Environment Configuration
# Reference: docs/TECHNOLOGY.md for the authoritative technology stack.

# ------------------------------------------------------------------------------
# CORE SYSTEM
# ------------------------------------------------------------------------------
OMNIX_ENV=development
OMNIX_LOG_LEVEL=debug
OMNIX_DATA_DIR=~/.omnix/data

# ------------------------------------------------------------------------------
# AI RUNTIME (Shared Intelligence)
# ------------------------------------------------------------------------------
# Default AI runtime and model. (Agent != Model).
# The single shared intelligence model is used for all major cognitive roles.
OLLAMA_HOST=http://127.0.0.1:11434
PRIMARY_LLM_MODEL=gemma4:31b

# ------------------------------------------------------------------------------
# SPEECH & VOICE
# ------------------------------------------------------------------------------
# STT Engine (faster-whisper baseline)
STT_PROVIDER=faster-whisper
STT_MODEL=large-v3-turbo

# TTS Engine (Chatterbox-Turbo baseline)
TTS_PROVIDER=chatterbox
TTS_VOICE_ID=omnix-core

# Voice Activity Detection / Wake Word
VAD_PROVIDER=silero
WAKE_WORD_ENGINE=openwakeword

# ------------------------------------------------------------------------------
# MEMORY & STORAGE
# ------------------------------------------------------------------------------
# SQLite is the primary baseline database. FTS5 is used for search.
# No embedding model or vector database is enabled by default.
MEMORY_DB_PATH=~/.omnix/data/omnix.db

# ------------------------------------------------------------------------------
# SAFETY & EXECUTION
# ------------------------------------------------------------------------------
# Controlled by the deterministic Policy Engine.
REQUIRE_CONFIRMATION_FOR_SENSITIVE=true
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
MAX_RECOVERY_ATTEMPTS=3

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Add integration specific keys here as modules are implemented
# e.g., GITHUB_TOKEN=
